+static void rdump_record_fs_config(const struct ext2_inode *inode,
+				   const char *fullname)
+{
+	const char *path = fullname;
+	size_t root_len;
+
+	if (!rdump_fs_config || !rdump_output_root)
+		return;
+	root_len = strlen(rdump_output_root);
+	if (strncmp(path, rdump_output_root, root_len) == 0) {
+		path += root_len;
+		while (*path == '/')
+			path++;
+	}
+	if (strpbrk(path, " \t\r\n")) {
+		com_err("rdump", 0, "cannot encode whitespace in fs_config path %s",
+			path);
+		return;
+	}
+	if (fprintf(rdump_fs_config, "%s %u %u %04o\n",
+		    *path ? path : "/", inode_uid(*inode), inode_gid(*inode),
+		    inode->i_mode & 07777) < 0)
+		com_err("rdump", errno, "while writing fs_config for %s", path);
+}
